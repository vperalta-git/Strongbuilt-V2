# Public site URL used for canonical URLs, sitemap, and social metadata
NEXT_PUBLIC_SITE_URL=https://www.strongbuilt.com.ph

# MongoDB Atlas (optional during local development; typed mock data is used without it)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=strongbuilt

# Keep false until the products collection is seeded and approved. Inquiries use
# MongoDB whenever MONGODB_URI is configured, independently of this setting.
MONGODB_CATALOG_ENABLED=false

# EmailJS browser configuration (optional; inquiries can still be saved to MongoDB)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional map embed URL. Leave blank to show the address/location placeholder panel.
NEXT_PUBLIC_MAP_EMBED_URL=
